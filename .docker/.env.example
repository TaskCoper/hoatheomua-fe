# Copy this file to `.docker/.env.demo` or `.docker/.env.prod`, then replace all
# placeholders before running `ENVIRONMENTS=<demo|prod> .docker/sync-env-secrets.sh`.
# Public values below are embedded in the browser bundle during `pnpm build`.
API_BASE_URL=https://api.example.com
TASKCOPER_API_BASE_URL=https://taskcoper-api.example.com
FILE_BASE_URL=https://files.example.com
SITE_URL=https://example.com
GOONG_MAP_API_KEY=public-browser-key
CLOUDGO_CHANNEL_ID=public-channel-id
PUBLIC_VIETMAP_API_KEY=public-browser-key

VIETMAP_API_KEY=server-only-key
REVALIDATE_SECRET=replace-with-a-long-random-secret
