{
  "name": "hoatheomua-fe",
  "version": "0.1.0",
  "private": true,
  "//engines": "Keep this at a Node that can require() ESM (>= 20.19 / 22.12). A runtime below that turned any ESM-only transitive dependency into a render-time ERR_REQUIRE_ESM - it took down every uncached render of /news/[slug] via jsdom, and stayed invisible until an ISR revalidation forced a re-render. Vercel resolves the function runtime from Settings -> Build and Deployment -> Node.js Version as well as from this field, so keep that on 24.x too.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node .husky/install.mjs",
    "i18n:lint": "node scripts/i18n-check.mjs --lint",
    "i18n:check": "node scripts/i18n-check.mjs --check",
    "i18n:unused": "node scripts/i18n-check.mjs --unused",
    "i18n:unused:fix": "node scripts/i18n-check.mjs --unused --fix",
    "i18n:fill": "node scripts/i18n-check.mjs --fill",
    "i18n:dupes": "node scripts/i18n-check.mjs --dupes",
    "i18n:verify": "pnpm run i18n:lint && pnpm run i18n:check",
    "verify:phone-auth": "node scripts/verify-phone-auth.mjs",
    "verify:pending-action": "node scripts/verify-pending-action.mjs",
    "verify:image-viewport": "node scripts/verify-image-viewport.mjs",
    "check": "pnpm run lint && pnpm run i18n:verify && pnpm run typecheck && pnpm run verify:image-viewport && pnpm run verify:phone-auth && pnpm run verify:pending-action"
  },
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,mjs,cjs,json,md,css,scss,html,yml,yaml}": [
      "prettier --write --ignore-unknown"
